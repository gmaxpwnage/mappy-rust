/target
/shots
/tmp
*.trace
# The cartridge image itself is copyrighted Namco material. Keep it out of
# version control; the game's own crate embeds the extracted PRG/CHR it needs.
/rom/*.nes
# Klaus Dormann's GPL test suite is fetched on demand, never vendored.
crates/mos6502/tests/data/*.bin
__pycache__/
*.pyc
/dist
# wasm build output copied into web/ for local testing
/web/mappy.wasm

# webOS NDK cache used by the workflows
/.webos-sdk
